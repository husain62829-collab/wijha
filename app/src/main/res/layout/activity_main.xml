<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7F8"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- عنوان التطبيق -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#153D4A"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="KAFAAT"
                android:textColor="#B5E5D9"
                android:textSize="11sp"/>

            <TextView
                android:id="@+id/txtAppName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="كفاءات"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/txtSlogan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="خدمات تناسب احتياجك"
                android:textColor="#E2F0EF"
                android:textSize="13sp"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="صمّم طلبك"
            android:textColor="#153D4A"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <!-- بيانات العميل -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="اسم العميل"
                android:textColor="#153D4A"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/editName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="اكتب اسمك"
                android:inputType="textPersonName"
                android:singleLine="true"
                android:textSize="20sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="نوع الخدمة"
                android:textColor="#153D4A"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <RadioGroup
                android:id="@+id/radioGroupServices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/radioService1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="الخدمة الأساسية"
                    android:textSize="14sp"/>

                <RadioButton
                    android:id="@+id/radioService2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="الخدمة المميزة"
                    android:textSize="14sp"/>
            </RadioGroup>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="6dp"
                android:background="#E2EBEC"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="إضافات اختيارية"
                android:textColor="#153D4A"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <CheckBox
                android:id="@+id/checkExtra1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="أولوية التنفيذ"
                android:textSize="14sp"/>

            <CheckBox
                android:id="@+id/checkExtra2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="متابعة خاصة"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/txtSelection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="#E8F5F1"
                android:padding="9dp"
                android:text="الإضافات: لا توجد إضافات"
                android:textColor="#166F69"
                android:textSize="12sp"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnNext"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#147C76"
            android:text="مراجعة الطلب"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"/>

    </LinearLayout>
</ScrollView>