<?xml version="1.0" encoding="utf-8"?>
<!-- [لم يتم التعديل] الحفاظ على ConstraintLayout كحاوية رئيسية -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background"
    android:layoutDirection="rtl">

    <!-- [تم التعديل] استخدام بطاقة زجاجية موحدة بدلاً من اللون الثابت الشفاف -->
    <androidx.cardview.widget.CardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:cardCornerRadius="30dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#B3FFFFFF"
        app:strokeColor="#60FFFFFF"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal">

            <!-- [لم يتم التعديل] الشعار كما هو -->
            <ImageView
                android:layout_width="140dp"
                android:layout_height="65dp"
                android:src="@drawable/logopic"
                android:scaleType="fitCenter"
                android:layout_marginBottom="16dp"/>

            <!-- [تم التعديل] استخدام ستايل العنوان الفرعي من الهوية -->
            <TextView
                style="@style/TextAppearance.Wajha.TitleSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="مرحباً بك في وجهتك القادمة"
                android:textColor="@color/primary_dark_green"
                android:layout_marginBottom="6dp"/>

            <!-- [تم التعديل] استخدام ستايل النص الأساسي بدلاً من الحجم الثابت -->
            <TextView
                style="@style/TextAppearance.Wajha.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="سجّل دخولك للوصول إلى عالم من التجارب والرحلات"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="24dp"
                android:gravity="center"/>

            <!-- [تم التعديل] استبدال edit_text_bg بخلفية الحقل الزجاجي الموحدة bg_login_input -->
            <EditText
                android:id="@+id/etUsername"
                style="@style/TextAppearance.Wajha.Body"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="@drawable/bg_login_input"
                android:hint="اسم المستخدم"
                android:textColorHint="@color/text_secondary"
                android:textColor="@color/text_primary"
                android:paddingHorizontal="20dp"
                android:layout_marginBottom="14dp"
                android:inputType="text"/>
<!--                android:drawableEnd="@android:drawable/ic_menu_myplaces"-->
<!--                android:drawableTint="@color/primary_dark_green"-->


            <!-- [تم التعديل] استبدال edit_text_bg بخلفية الحقل الزجاجي الموحدة bg_login_input -->
            <EditText
                android:id="@+id/etPassword"
                style="@style/TextAppearance.Wajha.Body"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="@drawable/bg_login_input"
                android:hint="كلمة المرور"
                android:textColorHint="@color/text_secondary"
                android:textColor="@color/text_primary"
                android:paddingHorizontal="20dp"
                android:layout_marginBottom="24dp"
                android:drawableTint="@color/primary_dark_green"
                android:inputType="textPassword"/>

            <!-- [تم التعديل] استخدام الزر المتدرج bg_btn_gradient بدلاً من اللون الثابت -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnLogin"
                style="@style/TextAppearance.Wajha.Button"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="تسجيل الدخول"
                android:textColor="@color/text_on_primary"
                android:background="@drawable/bg_btn_gradient"
                app:cornerRadius="25dp"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>