<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_white"
    android:layoutDirection="rtl">

    <!-- الصورة العلوية والشعار -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:background="@color/surface_white"
        android:theme="@style/ThemeOverlay.Material3.Dark">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:layout_width="match_parent"
            android:layout_height="220dp"
            app:contentScrim="@color/surface_white"
            app:expandedTitleGravity="center"
            app:layout_scrollFlags="scroll|exitUntilCollapsed">

            <ImageView
                android:id="@+id/headerImage"
                android:layout_width="match_parent"
                android:layout_height="230dp"
                android:scaleType="centerCrop"
                android:src="@drawable/top_card"/>
            <!--                app:layout_collapseMode="parallax"-->
            <!--                app:layout_collapseParallaxMultiplier="0.6" -->

            <!-- الشعار في منتصف الصورة -->
            <com.google.android.material.appbar.MaterialToolbar
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:layout_collapseMode="pin" />

        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- الجزء الأبيض القابل للارتفاع فوق الصورة -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/bookingScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:background="@android:color/transparent"
        android:layout_marginTop="0dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_white_top"
            android:padding="20dp">

            <!-- العنوان -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ماهي وجهتك التالية؟"
                android:textColor="@color/text_primary"
                android:textSize="25sp"
                android:textStyle="bold"
                android:gravity="right"
                android:layout_marginBottom="25dp" />

            <!-- نقطة المغادرة -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="نقطة المغادرة"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <Spinner
                android:id="@+id/departureSpinner"
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:background="@drawable/bg_input_field"
                android:padding="12dp"
                android:layout_marginBottom="25dp" />

            <!-- نوع الرحلة -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="نوع الرحلة"
                android:textColor="@color/text_primary"
                android:textSize="19sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:orientation="horizontal"
                android:layout_marginBottom="28dp">

                <TextView
                    android:id="@+id/domesticButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="داخلي"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="@drawable/bg_toggle_unselected"
                    android:textColor="@color/primary_blue"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/internationalButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="دولي"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="@drawable/bg_toggle_selected"
                    android:textColor="@color/text_on_primary"
                    android:layout_marginStart="8dp"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

            <!-- الوجهات -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="الوجهات"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="15dp" />

            <!-- هنا تنشأ بطاقات الوجهات من Java -->
            <LinearLayout
                android:id="@+id/destinationContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:animateLayoutChanges="true"
                />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <ImageView
        android:id="@+id/logoImage"
        android:layout_width="190dp"
        android:layout_height="97dp"
        android:layout_gravity="center"
        android:scaleType="fitCenter"
        android:src="@drawable/logowords"
        app:layout_anchor="@+id/appBar"
        app:layout_anchorGravity="center" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>