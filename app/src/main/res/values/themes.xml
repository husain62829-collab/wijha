<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ======================================================= -->
    <!-- [تم التعديل] الثيم الأساسي للتطبيق -->
    <!-- تم ربطه بهوية المشروع البصرية وألوان Material 3 -->
    <!-- ======================================================= -->
    <style name="Base.Theme.Wijha" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- [تمت الإضافة] تعيين خط IBM Plex Sans Arabic كخط افتراضي لكل التطبيق -->
        <item name="fontFamily">@font/ibm_plex_regular</item>
        <item name="android:fontFamily">@font/ibm_plex_regular</item>

        <!-- [تمت الإضافة] ربط الألوان الأساسية (Primary) -->
        <item name="colorPrimary">@color/primary_blue</item>
        <item name="colorOnPrimary">@color/text_on_primary</item>

        <!-- [تمت الإضافة] ربط الألوان الثانوية (Secondary) -->
        <item name="colorSecondary">@color/accent_mint_green</item>
        <item name="colorOnSecondary">@color/text_on_primary</item>

        <!-- [تمت الإضافة] ربط ألوان الخلفيات والأسطح (Surfaces) -->
        <item name="android:windowBackground">@color/background_app</item>
        <item name="colorSurface">@color/surface_white</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- [تمت الإضافة] تلوين شريط الحالة العلوي (Status Bar) -->
        <item name="android:statusBarColor">@color/background_app</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- لضمان عدم تأثر التطبيق بالألوان الديناميكية للهاتف (Dynamic Colors)
             حتى تظهر ألوان الهوية دائماً كما صممتها -->
        <item name="dynamicColorThemeOverlay" tools:targetApi="s">@null</item>
    </style>

    <!-- [تم التعديل] الثيم الفعلي المستخدم في التطبيق -->
    <style name="Theme.Wijha" parent="Base.Theme.Wijha" />

    <!-- ======================================================= -->
    <!-- [تمت الإضافة] أنماط إضافية جاهزة للاستخدام -->
    <!-- (حتى لا نكتبها يدوياً في كل شاشة) -->
    <!-- ======================================================= -->

    <!-- خلفية افتراضية للبطاقات والأسطح -->
    <style name="Widget.Wijha.CardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/surface_white</item>
        <item name="cardCornerRadius">@dimen/corner_large</item>
        <item name="cardElevation">4dp</item>
    </style>

    <!-- نمط أزرار Material الأساسية -->
    <style name="Widget.Wijha.Button" parent="Widget.Material3.Button">
        <item name="android:textAppearance">@style/TextAppearance.Wajha.Button</item>
        <item name="backgroundTint">@color/primary_blue</item>
        <item name="cornerRadius">@dimen/corner_medium</item>
    </style>

</resources>